import torch
from transformers import pipeline, AutoTokenizer, AutoModelForSeq2SeqLM

# Load summarization model and tokenizer
model_name = "facebook/bart-large-cnn"
tokenizer = AutoTokenizer.from_pretrained(model_name)
model = AutoModelForSeq2SeqLM.from_pretrained(model_name)

# Define summarization pipeline
summarizer = pipeline("summarization", model=model, tokenizer=tokenizer, device=0 if torch.cuda.is_available() else -1)

def summarize_text(text, max_length=None, min_length=None):
    input_length = len(tokenizer.encode(text, return_tensors="pt")[0])
    if max_length is None:
        max_length = max(10, int(0.5 * input_length))
    if min_length is None:
        min_length = max(5, int(0.25 * input_length))
    
    summary = summarizer(text, max_length=max_length, min_length=min_length, do_sample=False)
    return summary[0]['summary_text']

# Example usage
if __name__ == "__main__":
    text = """As a highly skilled and experienced Data Scientist and Analyst, I bring profound expertise in Artificial Intelligence. My
              technical proficiency spans various programming languages, machine learning frameworks, and data analytics tools. As
              a Certified AWS Solutions Architect and AWS Data Engineer, I also possess advanced knowledge of cloud architectures
              and services, enabling me to leverage cutting-edge technologies to solve complex problems in data management and
              analytics. I am passionate about merging analytical precision with innovative AI solutions to deliver impactful results."""
    
    summary = summarize_text(text)
    print("Original Text:")
    print(text)
    print("\nSummarized Text:")
    print(summary)
